# Copy to .env and fill in. .env is ignored by git; never commit real values.
# Every setting is listed in docs/configuration.md.

Loki__Url=http://loki:3100

# Start with a dry run: groups are logged, nothing is written to Jira.
Sync__DryRun=true

Jira__BaseUrl=https://your-site.atlassian.net
Jira__Email=
Jira__ApiToken=
Jira__ProjectKey=
Jira__IssueType=Bug

# Optional: enables GET /api/groups. Use a long random value.
Api__Key=
